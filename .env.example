# Choose one backend. If GROQ_API_KEY is set it's preferred (fast + free tier).
# If neither is set the pipeline falls back to a deterministic MOCK LLM — useful
# for CI and for running the eval harness without cost.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Model IDs (defaults are fine)
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Thresholds — tuned on the 20-ticket eval set. See README > "Threshold tuning".
SIM_THRESHOLD=0.45
CONFIDENCE_THRESHOLD=4

# Storage
CHROMA_DIR=./.chroma
KB_DIR=./knowledge_base

# Logging
LOG_LEVEL=INFO
